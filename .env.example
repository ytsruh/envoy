# JWT secret for authentication. Optional: if unset, the server generates
# and persists one to <state dir>/.jwt_secret (all sessions invalidate if lost).
# JWT_SECRET="your-secret-key-change-this-in-production"

# Database configuration. Defaults to a local sqlite file for self-hosting.
# TURSO_DATABASE_URL="./data/envoy.db"
# Remote Turso alternative:
# TURSO_DATABASE_URL="libsql://..."
# TURSO_AUTH_TOKEN="..."

# Local dev alternative (no token needed): file path or file: URL
# TURSO_DATABASE_URL="./envoy-local.db"

# Directory for persisted server state (.jwt_secret) when JWT_SECRET is unset.
# Defaults to the database file's parent dir, or ./data.
# ENVOY_STATE_DIR="./data"

# Server bind address. ADDR wins; otherwise $PORT is honoured when the
# host injects it. Default 0.0.0.0:8080.
# ADDR="0.0.0.0:8080"

# Log level (default warn). Accepts warn, info, debug, trace.
# ENVOY_LOG_LEVEL="info"

# CLI override for API base URL (default http://localhost:8080)
# ENVOY_SERVER_URL="http://localhost:8080"
