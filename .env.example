# JWT Secret for authentication (use a strong random string in production)
JWT_SECRET="your-secret-key-change-this-in-production"

# Database configuration (Turso remote)
# Preferred names:
TURSO_DATABASE_URL=""
TURSO_AUTH_TOKEN=""
# Legacy Go names (still accepted as fallback):
# DB_URL=""
# DB_TOKEN=""

# Local dev alternative (no token needed): file path or file: URL
# TURSO_DATABASE_URL="./envoy-local.db"

# Server bind address (default 0.0.0.0:8080)
# ADDR="0.0.0.0:8080"

# CLI override for API base URL (default https://envoy.webiliti.com)
# ENVOY_SERVER_URL="http://localhost:8080"
